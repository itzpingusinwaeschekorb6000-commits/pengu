#!/bin/sh
# Regenerates src/resources.qrc from the files in src/, so a new sprite, QML
# file or translation is picked up without editing XML by hand.
set -eu
# The same file order on every machine.
export LC_ALL=C
cd "$(dirname -- "$0")/../src"
tmp="resources.qrc.$$"
{
  echo '<RCC>'
  echo '    <qresource prefix="/">'
  for f in qml/qmldir qml/*.qml sprites/*.svg data/*.json i18n/*.json; do
    [ -e "$f" ] && echo "        <file>$f</file>"
  done
  echo '    </qresource>'
  echo '</RCC>'
} > "$tmp"
# Replaced only when the list changed, and in one step: rcc reruns only when
# needed, and a build running in parallel never reads half a file.
if cmp -s "$tmp" resources.qrc; then rm -f "$tmp"; else mv -f "$tmp" resources.qrc; fi
