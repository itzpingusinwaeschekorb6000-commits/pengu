#!/bin/sh
# Installs everything needed to build the Android app into ~/Qt and
# ~/Android (several GB, nothing system-wide): Qt for Android, JDK 17,
# the Android SDK and NDK, and KDAB's OpenSSL builds.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
. "$ROOT/bin/android-env"

if [ ! -x "$QT_ANDROID/bin/qmake" ]; then
  uvx --from aqtinstall aqt install-qt linux desktop "$QT_VERSION_ANDROID" linux_gcc_64 -O "$QT_ROOT"
  uvx --from aqtinstall aqt install-qt all_os android "$QT_VERSION_ANDROID" android_arm64_v8a -O "$QT_ROOT"
fi

if [ -z "$JAVA_HOME" ] || [ ! -x "$JAVA_HOME/bin/java" ]; then
  mise install java@temurin-17
  JAVA_HOME="$(mise where java@temurin-17)"
  export JAVA_HOME
fi

SDKMANAGER="$ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"
if [ ! -x "$SDKMANAGER" ]; then
  mkdir -p "$ANDROID_SDK_ROOT/cmdline-tools"
  zip="$(mktemp --suffix=.zip)"
  curl -fsSLo "$zip" https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip
  unzip -q "$zip" -d "$ANDROID_SDK_ROOT/cmdline-tools"
  mv "$ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools" "$ANDROID_SDK_ROOT/cmdline-tools/latest"
  rm -f "$zip"
fi
yes | "$SDKMANAGER" --licenses >/dev/null || true
"$SDKMANAGER" "platform-tools" "platforms;$ANDROID_PLATFORM" "build-tools;$BUILD_TOOLS" "ndk;$NDK_VERSION"

[ -d "$ANDROID_OPENSSL" ] || git clone --depth 1 https://github.com/KDAB/android_openssl.git "$ANDROID_OPENSSL"

echo "Android toolchain ready. Next: bin/android-key (once), then bin/android-build."
