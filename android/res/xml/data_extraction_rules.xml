<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: downloaded updates are neither backed up nor moved to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="updates/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="updates/"/>
    </device-transfer>
</data-extraction-rules>
