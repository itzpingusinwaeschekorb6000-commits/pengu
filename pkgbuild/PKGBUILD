pkgname=pengu
# Same version as the Android app: VERSION plus the commit count. Computed
# here rather than in pkgver(), which would rewrite this file on every build.
pkgver="$(cat "$startdir/../VERSION").${PENGU_BUILD:-$(git -C "$startdir/.." rev-list --count HEAD)}"
pkgrel=1
pkgdesc='Build habits and grow an African penguin island'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'libnotify' 'polkit')
makedepends=('gcc' 'make' 'git')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/pengu "$pkgdir/usr/bin/pengu"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/pengu.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/pengu.svg"
  install -Dm644 "$startdir/pengu.desktop" "$pkgdir/usr/share/applications/pengu.desktop"
}
